data/**/*.parquet
data/**/*.feather
data/**/*.jsonl
data/**/*.pkl
data/**/*.bin
data/**/*.npy
data/**/*.pt
data/**/*.idx
data/**/*.faiss
data/**/cache/
cache/
.tmp/
tmp/

